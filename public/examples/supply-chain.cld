{
  "version": "2.0",
  "diagramName": "Supply Chain Dynamics",
  "description": "Supply chain with inventory management and demand forecasting",
  "category": "Operations",
  "nodes": [
    {
      "id": "demand",
      "label": "Customer Demand",
      "type": "variable",
      "position": { "x": 100, "y": 150 },
      "color": "#10B981",
      "size": 65
    },
    {
      "id": "inventory",
      "label": "Inventory Level",
      "type": "variable",
      "position": { "x": 300, "y": 150 },
      "color": "#3B82F6",
      "size": 65
    },
    {
      "id": "production",
      "label": "Production Rate",
      "type": "variable",
      "position": { "x": 500, "y": 150 },
      "color": "#F59E0B",
      "size": 65
    },
    {
      "id": "backlog",
      "label": "Order Backlog",
      "type": "variable",
      "position": { "x": 200, "y": 250 },
      "color": "#EF4444",
      "size": 60
    },
    {
      "id": "forecast",
      "label": "Demand Forecast",
      "type": "variable",
      "position": { "x": 400, "y": 250 },
      "color": "#8B5CF6",
      "size": 60
    }
  ],
  "edges": [
    {
      "id": "edge1",
      "source": "demand",
      "target": "inventory",
      "polarity": "negative",
      "type": "causal",
      "label": "Higher demand reduces inventory"
    },
    {
      "id": "edge2",
      "source": "inventory",
      "target": "backlog",
      "polarity": "negative",
      "type": "causal",
      "label": "Low inventory increases backlog"
    },
    {
      "id": "edge3",
      "source": "backlog",
      "target": "production",
      "polarity": "positive",
      "type": "causal",
      "label": "Backlog drives production increase"
    },
    {
      "id": "edge4",
      "source": "production",
      "target": "inventory",
      "polarity": "positive",
      "type": "causal",
      "label": "Production replenishes inventory"
    },
    {
      "id": "edge5",
      "source": "demand",
      "target": "forecast",
      "polarity": "positive",
      "type": "causal",
      "label": "Demand influences forecast"
    },
    {
      "id": "edge6",
      "source": "forecast",
      "target": "production",
      "polarity": "positive",
      "type": "causal",
      "label": "Forecast guides production planning"
    }
  ],
  "viewTransform": { "x": 0, "y": 0, "scale": 1 },
  "showGrid": true,
  "globalStyles": {
    "nodeColor": "#3B82F6",
    "edgeColor": "#6B7280",
    "backgroundColor": "#FFFFFF"
  },
  "problemStatement": {
    "mode": "sandbox",
    "currentProblem": null,
    "customStatement": "Analyze supply chain dynamics and inventory management strategies"
  },
  "analysis": {
    "adjacencyMatrix": [],
    "allLoops": []
  },
  "simulation": {
    "isInitialized": false,
    "timeStep": 1,
    "duration": 100
  }
} 