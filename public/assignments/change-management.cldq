      "id": "q1",
      "questionType": "text",
      "question": "Explain how resistance to change can create reinforcing feedback loops in organizations.",
      "maxScore": 15,
      "timeLimit": 300,
      "correctAnswer": "Resistance to change can create reinforcing feedback loops where initial resistance leads to increased management pressure, which in turn increases employee resistance and fear. This creates a vicious cycle where resistance feeds more resistance, making change implementation increasingly difficult. The loop is reinforced by factors like fear of the unknown, loss of control, and perceived threats to job security.",
      "keywords": ["resistance", "reinforcing loop", "vicious cycle", "management pressure", "fear", "change implementation"],
      "cldContext": "basic-feedback-loop"
    },
    {
      "id": "q2",
      "questionType": "mcq",
      "question": "What type of feedback loop typically helps organizations adapt to change?",
      "options": ["Reinforcing loop", "Balancing loop", "Delayed loop", "Random loop"],
      "maxScore": 10,
      "timeLimit": 120,
      "correctAnswer": "Balancing loop",
      "cldContext": "market-growth"
    },
    {
      "id": "q3",
      "questionType": "nat",
      "question": "If change resistance increases by 20% and management pressure increases by 30%, what is the overall resistance multiplier?",
      "maxScore": 8,
      "timeLimit": 180,
      "correctAnswer": "1.56",
      "tolerance": 0.1,
      "cldContext": "predator-prey"
    },
