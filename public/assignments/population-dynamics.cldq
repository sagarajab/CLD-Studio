      "id": "q1",
      "questionType": "text",
      "question": "Explain the concept of exponential growth and its relationship to carrying capacity in population dynamics.",
      "maxScore": 15,
      "timeLimit": 300,
      "correctAnswer": "Exponential growth occurs when a population increases at a rate proportional to its current size, creating a J-shaped curve. This happens when resources are abundant and there are no limiting factors. However, exponential growth cannot continue indefinitely because of carrying capacity - the maximum population size that the environment can sustain. When a population approaches carrying capacity, growth slows and eventually stabilizes, creating an S-shaped logistic growth curve. The transition from exponential to logistic growth is driven by negative feedback loops through resource limitation.",
      "keywords": ["exponential growth", "carrying capacity", "logistic growth", "J-shaped curve", "S-shaped curve", "negative feedback", "resource limitation"],
      "cldContext": "predator-prey"
    },
    {
      "id": "q2",
      "questionType": "mcq",
      "question": "What type of growth curve does a population show when it reaches carrying capacity?",
      "options": ["J-shaped", "S-shaped", "Linear", "Circular"],
      "maxScore": 8,
      "timeLimit": 120,
      "correctAnswer": "S-shaped",
      "cldContext": "basic-feedback-loop"
    },
